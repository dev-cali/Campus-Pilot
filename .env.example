AI_API_KEY=your_openai_api_key_here

# Optional demo override; source default is 400 (range: 128–1000).
# Uncomment to reproduce the reported fictional demo test:
# AI_MAX_COMPLETION_TOKENS=1000
DATABASE_URL=your_postgresql_database_url_here
PINECONE_API_KEY=your_pinecone_api_key_here
JWT_SECRET=your_jwt_secret_here
STORAGE_KEY=your_storage_key_here
ADMIN_SECRET=your_admin_secret_here

# Supabase Auth: auth.py verifies access tokens with this secret.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
# Optional expected issuer, e.g. https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
# Comma-separated frontend origins allowed to call the API with credentials.
ALLOWED_ORIGINS=http://localhost:3000
# Optional AI demo completion limit.
# Default: 400; supported range: 128-3000.
AI_MAX_COMPLETION_TOKENS=3000
AI_MODEL=gpt-5-mini

# Private server-to-server authentication.
# Generate a unique secret for your deployment.
# Never commit the actual value.
AI_DEMO_SHARED_SECRET=

# Restricted AI evaluator access (Next.js server only).
AI_DEMO_USERNAME=evaluator
AI_DEMO_PASSWORD=

# AI demo request limits (per application instance).
AI_DEMO_REQUESTS_PER_MINUTE=5
AI_DEMO_REQUESTS_PER_DAY=100