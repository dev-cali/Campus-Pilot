AI_API_KEY=your_openai_api_key_here
DATABASE_URL=your_postgresql_database_url_here
PINECONE_API_KEY=your_pinecone_api_key_here
JWT_SECRET=your_jwt_secret_here
STORAGE_KEY=your_storage_key_here
ADMIN_SECRET=your_admin_secret_here

# Supabase Auth: auth.py verifies access tokens with this secret.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
# Optional expected issuer, e.g. https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
# Comma-separated frontend origins allowed to call the API with credentials.
ALLOWED_ORIGINS=http://localhost:3000
